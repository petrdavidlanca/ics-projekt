<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StackOverFIT.App.Views"
    xmlns:vm="clr-namespace:StackOverFIT.App.ViewModels"
    x:DataType="vm:UserEditViewModel"
    x:Class="StackOverFIT.App.Views.User.UserEditView"
    BackgroundColor="#1b2838">

    <Grid RowDefinitions="Auto, *" Padding="0,40,0,40">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="20" Padding="0,20">

                <Frame BackgroundColor="#2a475e" BorderColor="#3d5a73"
                       CornerRadius="6" Padding="30" WidthRequest="320" HasShadow="False">
                    <VerticalStackLayout Spacing="14">

                        <!-- Avatar -->
                        <Image Source="user_placeholder.png" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" />

                        <!-- Povinné pole: Username -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Username *" TextColor="#c6d4df" FontSize="12" />
                            <Entry Text="{Binding User.Username}"
                                   Placeholder="Username" PlaceholderColor="#7a8b99"
                                   TextColor="White" BackgroundColor="#3d5266"
                                   FontSize="14" ReturnType="Next" />
                        </VerticalStackLayout>

                        <!-- Povinné pole: Email -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Email *" TextColor="#c6d4df" FontSize="12" />
                            <Entry Text="{Binding User.Email}"
                                   Placeholder="user@email.com" PlaceholderColor="#7a8b99"
                                   TextColor="White" BackgroundColor="#3d5266"
                                   FontSize="14" Keyboard="Email" ReturnType="Next" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#3d5a73" Margin="0,4" />

                        <!-- Nepovinné: Jméno -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="First name (optional)" TextColor="#c6d4df" FontSize="12" />
                            <Entry Text="{Binding User.RealName}"
                                   Placeholder="First name" PlaceholderColor="#7a8b99"
                                   TextColor="White" BackgroundColor="#3d5266"
                                   FontSize="14" ReturnType="Next" />
                        </VerticalStackLayout>

                        <!-- Nepovinné: Příjmení -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Surname (optional)" TextColor="#c6d4df" FontSize="12" />
                            <Entry Text="{Binding User.Surname}"
                                   Placeholder="Surname" PlaceholderColor="#7a8b99"
                                   TextColor="White" BackgroundColor="#3d5266"
                                   FontSize="14" ReturnType="Done" />
                        </VerticalStackLayout>

                        <!-- SAVE -->
                        <Button Text="SAVE"
                                BackgroundColor="#5ba32b" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                CornerRadius="3" HeightRequest="42"
                                Command="{Binding SaveCommand}" />

                        <!-- CANCEL -->
                        <Button Text="CANCEL"
                                BackgroundColor="#3d4450" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                CornerRadius="3" HeightRequest="42"
                                Command="{Binding CancelCommand}" />

                        <!-- DELETE – jen při editaci existujícího -->
                        <Button Text="DELETE"
                                BackgroundColor="#8b1a1a" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                CornerRadius="3" HeightRequest="42"
                                IsVisible="{Binding IsExistingUser}" />

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</views:ContentPageBase>
