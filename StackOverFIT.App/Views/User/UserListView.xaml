<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StackOverFIT.App.Views"
    xmlns:vm="clr-namespace:StackOverFIT.App.ViewModels"
    xmlns:models="clr-namespace:StackOverFIT.BL.Models;assembly=StackOverFIT.BL"
    x:DataType="vm:UserListViewModel"
    x:Class="StackOverFIT.App.Views.User.UserListView"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="#1b2838">

    <Grid RowDefinitions="Auto, *" Padding="0,40,0,40">

        <Label Grid.Row="0"
               Text="Choose an account"
               FontSize="36" TextColor="White"
               HorizontalOptions="Center"
               Margin="0,0,0,40" />

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalOptions="Center">
            <HorizontalStackLayout Spacing="24" Padding="60,0" VerticalOptions="Center">

                <HorizontalStackLayout Spacing="24"
                                       BindableLayout.ItemsSource="{Binding Users}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:UserListModel">
                            <Frame BackgroundColor="#2a475e" BorderColor="#3d5a73"
                                   CornerRadius="6" Padding="20" WidthRequest="210"
                                   HasShadow="False">
                                <VerticalStackLayout Spacing="10">

                                    <Image Source="user_placeholder.png" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" />

                                    <Frame BackgroundColor="#3d5266" BorderColor="Transparent"
                                           Padding="8,6" CornerRadius="3" HasShadow="False">
                                        <Label Text="{Binding Username}" TextColor="White"
                                               FontSize="14" HorizontalTextAlignment="Center" />
                                    </Frame>

                                    <Frame BackgroundColor="#3d5266" BorderColor="Transparent"
                                           Padding="8,6" CornerRadius="3" HasShadow="False">
                                        <Label Text="{Binding Email}" TextColor="#c6d4df"
                                               FontSize="13" HorizontalTextAlignment="Center" />
                                    </Frame>

                                    <Button Text="LOG IN"
                                            BackgroundColor="#1a7bc4" TextColor="White"
                                            FontAttributes="Bold" FontSize="13"
                                            CornerRadius="3" HeightRequest="38"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserListViewModel}}, Path=GoToDetailCommand}"
                                            CommandParameter="{Binding Id}" />

                                    <Button Text="EDIT"
                                            BackgroundColor="#f5a623" TextColor="White"
                                            FontAttributes="Bold" FontSize="13"
                                            CornerRadius="3" HeightRequest="38"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserListViewModel}}, Path=GoToEditCommand}"
                                            CommandParameter="{Binding Id}" />

                                    <Button Text="DELETE"
                                            BackgroundColor="#8b1a1a" TextColor="White"
                                            FontAttributes="Bold" FontSize="13"
                                            CornerRadius="3" HeightRequest="38"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserListViewModel}}, Path=DeleteCommand}"
                                            CommandParameter="{Binding Id}" />

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <Frame BackgroundColor="#2a475e" BorderColor="#3d5a73"
                       CornerRadius="6" Padding="20" WidthRequest="210" HasShadow="False">
                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                        <Image Source="user_placeholder.png" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" />
                        <Button Text="REGISTER"
                                BackgroundColor="#5ba32b" TextColor="White"
                                FontAttributes="Bold" FontSize="13"
                                CornerRadius="3" HeightRequest="38"
                                Command="{Binding GoToCreateCommand}" />
                    </VerticalStackLayout>
                </Frame>

            </HorizontalStackLayout>
        </ScrollView>

    </Grid>
</views:ContentPageBase>
