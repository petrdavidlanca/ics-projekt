<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StackOverFIT.App.Views"
    xmlns:vm="clr-namespace:StackOverFIT.App.ViewModels"
    xmlns:models="clr-namespace:StackOverFIT.BL.Models;assembly=StackOverFIT.BL"
    x:DataType="vm:LibraryListViewModel"
    x:Class="StackOverFIT.App.Views.Library.LibraryListView"
    BackgroundColor="#1b2838">

    <Grid RowDefinitions="Auto, Auto, *" Padding="40,30,40,20">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <Label Grid.Column="0"
                   Text="My Libraries"
                   FontSize="32"
                   TextColor="White"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="+ NEW LIBRARY"
                    BackgroundColor="#5ba32b"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="3"
                    HeightRequest="38"
                    Command="{Binding GoToCreateCommand}" />
        </Grid>

        <!-- Search / Filter / Sort bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto, Auto, Auto, *"
              ColumnSpacing="8"
              Margin="0,0,0,16">
            <Button Grid.Column="0"
                    Text="Filter ▾"
                    BackgroundColor="#3d4450"
                    TextColor="White"
                    FontSize="13"
                    CornerRadius="3"
                    HeightRequest="36" />
            <Button Grid.Column="1"
                    Text="Sort ▾"
                    BackgroundColor="#3d4450"
                    TextColor="White"
                    FontSize="13"
                    CornerRadius="3"
                    HeightRequest="36" />
            <Button Grid.Column="2"
                    Text="Search"
                    BackgroundColor="#1a7bc4"
                    TextColor="White"
                    FontSize="13"
                    CornerRadius="3"
                    HeightRequest="36" />
            <Entry Grid.Column="3"
                   Placeholder="Library name"
                   PlaceholderColor="#7a8b99"
                   TextColor="White"
                   BackgroundColor="#3d5266"
                   FontSize="13"
                   HeightRequest="36" />
        </Grid>

        <!-- Library list -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Libraries}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LibraryListModel">
                    <Grid Padding="0,4">
                        <Frame BackgroundColor="#2a475e"
                               BorderColor="#3d5a73"
                               CornerRadius="4"
                               Padding="16,12"
                               HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">

                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           TextColor="White"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding NumOfGames, StringFormat='{0} Games'}"
                                           TextColor="#c6d4df"
                                           FontSize="13" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="OPEN"
                                        BackgroundColor="#1a7bc4"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        CornerRadius="3"
                                        HeightRequest="36"
                                        WidthRequest="80"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryListViewModel}}, Path=GoToDetailCommand}"
                                        CommandParameter="{Binding Id}" />

                                <Button Grid.Column="2"
                                        Text="EDIT"
                                        BackgroundColor="#f5a623"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        CornerRadius="3"
                                        HeightRequest="36"
                                        WidthRequest="80"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryListViewModel}}, Path=GoToEditCommand}"
                                        CommandParameter="{Binding Id}" />
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</views:ContentPageBase>
