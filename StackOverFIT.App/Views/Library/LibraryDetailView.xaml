<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StackOverFIT.App.Views"
    xmlns:vm="clr-namespace:StackOverFIT.App.ViewModels"
    xmlns:models="clr-namespace:StackOverFIT.BL.Models;assembly=StackOverFIT.BL"
    x:DataType="vm:LibraryDetailViewModel"
    x:Class="StackOverFIT.App.Views.Library.LibraryDetailView"
    BackgroundColor="#1b2838"
    x:Name="RootPage">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="40,30,40,20">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1b2838" Offset="0.0" />
                <GradientStop Color="#0a0f16" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto, Auto"
              ColumnSpacing="12" Margin="0,0,0,20">

            <Button Grid.Column="0" Text="EDIT"
                    BackgroundColor="#f5a623" TextColor="White"
                    ImageSource="edit_icon.png" 
                    ContentLayout="Right, 6"
                    FontAttributes="Bold" FontSize="13"
                    CornerRadius="3" HeightRequest="38"
                    VerticalOptions="Center"
                    Command="{Binding GoToEditCommand}" />

            <Label Grid.Column="1"
                   Text="{Binding Library.Name}"
                   FontSize="32" TextColor="White"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   Text="{Binding Library.NumOfGames, StringFormat='{0} Games'}"
                   FontSize="24" TextColor="#c6d4df"
                   VerticalOptions="Center" />

            <Button Grid.Column="3" Text="DELETE"
                    BackgroundColor="#8b1a1a" TextColor="White"
                    ImageSource="delete_icon.png"
                    ContentLayout="Left, 6"
                    FontAttributes="Bold" FontSize="13"
                    CornerRadius="3" HeightRequest="38"
                    VerticalOptions="Center"
                    Command="{Binding DeleteCommand}" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto, Auto, Auto, *"
              ColumnSpacing="8" Margin="0,0,0,16">
            <Button Grid.Column="0" Text="Filter"
                    ImageSource="filter_icon.png" ContentLayout="Right, 6"
                    BackgroundColor="#3d4450" TextColor="White" FontSize="13" 
                    CornerRadius="3" HeightRequest="36" 
                    Command="{Binding ToggleFilterMenuCommand}" />

            <Button Grid.Column="1" Text="Sort" 
                    ImageSource="sort_icon.png" ContentLayout="Right, 6"
                    BackgroundColor="#3d4450" TextColor="White" FontSize="13" 
                    CornerRadius="3" HeightRequest="36"
                    Command="{Binding SortCommand}" />

            <Button Grid.Column="2" Text="Search" 
                    ImageSource="search_icon.png" ContentLayout="Right, 6"
                    BackgroundColor="#1a7bc4" TextColor="White" FontSize="13" 
                    CornerRadius="3" HeightRequest="36"
                    Command="{Binding SearchCommand}" />

            <Entry Grid.Column="3"
                   Placeholder="Game name" PlaceholderColor="#7a8b99"
                   TextColor="White" BackgroundColor="#3d5266"
                   FontSize="13" HeightRequest="36"
                   Text="{Binding SearchText}"
                   ReturnCommand="{Binding SearchCommand}" />
        </Grid>

        <CollectionView Grid.Row="3" ItemsSource="{Binding DisplayedGames}">
            <CollectionView.EmptyView>
                <Label Text="No games match your search, or the library is empty."
                       TextColor="#7a8b99" FontSize="14" Margin="0,20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VideoGameListModel">
                    <Grid Padding="0,4">
                        <Frame BackgroundColor="#2a475e" BorderColor="#3d5a73"
                               CornerRadius="4" Padding="0" HasShadow="False">
                            <Grid ColumnDefinitions="120, *, Auto, Auto" ColumnSpacing="0">

                                <Border Grid.Column="0"
                                        BackgroundColor="#3d5266" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4,0,0,4" />
                                    </Border.StrokeShape>

                                    <Image Aspect="AspectFill"
                                           HeightRequest="80" WidthRequest="120"
                                           Source="{Binding ImageUrl}" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       TextColor="White" FontSize="16" FontAttributes="Bold"
                                       Padding="16,0" VerticalOptions="Center" />

                                <Button Grid.Column="2" Text="PLAY"
                                        BackgroundColor="#1a7bc4" TextColor="White"
                                        ImageSource="play_icon.png"
                                        ContentLayout="Left, 6"
                                        FontAttributes="Bold" FontSize="12"
                                        CornerRadius="3" HeightRequest="36"
                                        Margin="0,0,8,0" VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryDetailViewModel}}, Path=PlayGameCommand}"
                                        CommandParameter="{Binding Id}" />

                                <Button Grid.Column="3" Text="REMOVE"
                                        BackgroundColor="#8b1a1a" TextColor="White"
                                        ImageSource="remove_icon.png" 
                                        ContentLayout="Left, 6"
                                        FontAttributes="Bold" FontSize="13"
                                        CornerRadius="3" WidthRequest="110"
                                        Margin="0,0,12,0" VerticalOptions="Center"
                                        Command="{Binding BindingContext.RemoveVideoGameCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding Id}" />
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <BoxView Grid.Row="0" Grid.RowSpan="4"
                 Color="Transparent"
                 IsVisible="{Binding IsFilterMenuVisible}"
                 ZIndex="5">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseFilterMenuCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border Grid.Row="3"
                IsVisible="{Binding IsFilterMenuVisible}"
                BackgroundColor="#2a475e"
                Stroke="#3d5a73"
                StrokeThickness="1"
                WidthRequest="180"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="0, -5, 0, 0" 
                ZIndex="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>

            <HorizontalStackLayout Padding="12, 8">
                <CheckBox IsChecked="{Binding ShowAdultGames}" Color="#1a7bc4" />
                <Label Text="Show 18+ Games" 
                       TextColor="White" 
                       FontSize="13"
                       VerticalOptions="Center" 
                       Margin="8,0,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterMenuCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </Border>

    </Grid>
</views:ContentPageBase>