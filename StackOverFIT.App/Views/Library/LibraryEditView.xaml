<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StackOverFIT.App.Views"
    xmlns:vm="clr-namespace:StackOverFIT.App.ViewModels"
    x:DataType="vm:LibraryEditViewModel"
    x:Class="StackOverFIT.App.Views.Library.LibraryEditView"
    BackgroundColor="#1b2838">

    <Grid RowDefinitions="Auto, *" Padding="0,40,0,40">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1b2838" Offset="0.0" />
                <GradientStop Color="#0a0f16" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="20"
                                 Padding="0,20">

                <Label Text="Edit Library"
                       FontSize="28"
                       TextColor="White"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10" />

                <Frame BackgroundColor="#2a475e"
                       BorderColor="#3d5a73"
                       CornerRadius="6"
                       Padding="30"
                       WidthRequest="340"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="Library name"
                               TextColor="#c6d4df"
                               FontSize="13" />
                        <Entry Text="{Binding Library.Name}"
                               Placeholder="Library name"
                               PlaceholderColor="#7a8b99"
                               TextColor="White"
                               BackgroundColor="#3d5266"
                               FontSize="14"
                               ReturnType="Done" />

                        <Button Text="SAVE"
                                BackgroundColor="#5ba32b"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="3"
                                HeightRequest="42"
                                Command="{Binding SaveCommand}" />

                        <Button Text="CANCEL"
                                BackgroundColor="#3d4450"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="3"
                                HeightRequest="42" 
                                Command="{Binding CancelCommand}" />

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</views:ContentPageBase>
