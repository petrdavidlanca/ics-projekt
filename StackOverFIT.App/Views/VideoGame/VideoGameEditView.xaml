<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StackOverFIT.App.Views"
    xmlns:vm="clr-namespace:StackOverFIT.App.ViewModels"
    x:DataType="vm:VideoGameEditViewModel"
    x:Class="StackOverFIT.App.Views.VideoGame.VideoGameEditView"
    BackgroundColor="#1b2838">

    <Grid RowDefinitions="Auto, *" Padding="0,30,0,40">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="0" Padding="0,10">

                <Label Text="{Binding PageTitle}"
                       FontSize="28" TextColor="White"
                       HorizontalOptions="Center" Margin="0,0,0,24" />

                <Frame BackgroundColor="#2a475e" BorderColor="#3d5a73"
                       CornerRadius="6" Padding="30" WidthRequest="560" HasShadow="False">
                    
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Game name *" TextColor="#c6d4df" FontSize="12" />
                            <Entry Text="{Binding VideoGame.Name}"
                                   Placeholder="Game name" PlaceholderColor="#7a8b99"
                                   TextColor="White" BackgroundColor="#3d5266"
                                   FontSize="14" ReturnType="Next" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="PEGI Rating *" TextColor="#c6d4df" FontSize="12" />
                            <Picker Title="Select PEGI rating"
                                    ItemsSource="{Binding AvailablePegiRatings}"
                                    SelectedItem="{Binding VideoGame.PegiRating}" 
                                    TextColor="White"
                                    TitleColor="#7a8b99"
                                    BackgroundColor="#3d5266"
                                    FontSize="14">
                            </Picker>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Description *" TextColor="#c6d4df" FontSize="12" />
                            <Editor Text="{Binding VideoGame.Description}"
                                    Placeholder="Game description" PlaceholderColor="#7a8b99"
                                    TextColor="#c6d4df" BackgroundColor="#3d5266"
                                    FontSize="13" HeightRequest="80"
                                    AutoSize="TextChanges" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Image URL (optional)" TextColor="#c6d4df" FontSize="12" />
                            <Entry Text="{Binding VideoGame.ImageUrl}"
                                   Placeholder="https://..." PlaceholderColor="#7a8b99"
                                   TextColor="White" BackgroundColor="#3d5266"
                                   FontSize="13" Keyboard="Url" ReturnType="Done" />
                        </VerticalStackLayout>

                        <Button Text="SAVE"
                                BackgroundColor="#5ba32b" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                CornerRadius="3" HeightRequest="42"
                                Margin="0,10,0,0"
                                Command="{Binding SaveCommand}" />

                    </VerticalStackLayout>

                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:ContentPageBase>